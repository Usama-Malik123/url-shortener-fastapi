# Postgres
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=urlshortener

# App (used by the app process directly; in docker-compose these are
# derived from the POSTGRES_* values above via docker-compose.yml, but
# set them explicitly when running the app outside docker-compose)
DATABASE_URL=postgresql+psycopg://urlshortener:change-me@localhost:5432/urlshortener
REDIS_URL=redis://localhost:6379/0

# App behavior
CACHE_TTL_SECONDS=3600
SHORT_CODE_LENGTH=7
BASE_URL=http://localhost:8000
